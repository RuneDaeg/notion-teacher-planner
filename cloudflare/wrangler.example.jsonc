{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "notion-teacher-planner",
  "main": "src/index.mjs",
  "compatibility_date": "2026-09-30",
  "workers_dev": true,
  "assets": {"directory": "../cloud/web", "binding": "ASSETS", "run_worker_first": ["/api/*"]},
  "triggers": {"crons": ["* * * * *"]},
  "observability": {"enabled": false},
  "d1_databases": [{"binding": "DB", "database_name": "teacher-planner", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations"}],
  "vars": {"PUBLIC_BASE_URL": "https://planner.example.invalid", "NOTION_CLIENT_ID": "configure-before-deploy", "MAX_INSTALLATIONS": "50", "MAX_DAILY_STEPS": "1000"}
}
