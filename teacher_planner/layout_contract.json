    "full_width": true,
    "small_text": false,
    "setting_method": "page_properties_or_browser_ui",
    "verify_readback": true
  },
  "rules": {
    "section_order": "rows_then_columns_then_sections",
    "optional_sections": "omit_when_absent; never create an unselected module",
    "optional_columns": "remove_empty_columns_and_renormalize; singleton_is_full_width",
    "unknown_sections": "error; inventory and place existing custom content explicitly",
    "database_views": "one_existing_linked_database_per_section; all section views are tabs on that database",
    "database_properties": "visible properties, filters, and sorts inherit blueprint.json",
    "preservation": "preserve supplied native page/database/block URLs, synced references, records, and selected modules",
    "closed_toggles": "render details then confirm collapsed in browser; Markdown does not encode open state",
    "widths": "fixed relative column ratios, no CSS; inspect at the same desktop viewport",
    "unsupported_layout": "record blocked/incomplete; never silently downgrade to a vertical layout",
    "visual_completion": "requires actual page settings readback and browser screenshots; rendering alone is not completion",
    "column_ratio_tolerance_percentage_points": 0.5
  },
  "timetable": {
