          "type": "rich_text"
        },
        "마감 남은 일": {
          "type": "formula",
          "expression": "if(or(empty(prop(\"마감\")), or(prop(\"상태\") == \"완료\", prop(\"상태\") == \"취소\")), 0, dateBetween(parseDate(formatDate(dateStart(prop(\"마감\")), \"YYYY-MM-DD\")), today(), \"days\"))"
        },
        "마감 임박": {
          "type": "formula",
          "expression": "if(or(empty(prop(\"마감\")), or(prop(\"상태\") == \"완료\", prop(\"상태\") == \"취소\")), false, and(prop(\"마감 남은 일\") >= 0, prop(\"마감 남은 일\") <= 7))"
        },
        "D-Day": {
          "type": "formula",
          "expression": "if(or(empty(prop(\"마감\")), or(prop(\"상태\") == \"완료\", prop(\"상태\") == \"취소\")), \"\", if(prop(\"마감 남은 일\") == 0, \"D-Day\", if(prop(\"마감 남은 일\") > 0, \"D-\" + format(prop(\"마감 남은 일\")), \"D+\" + format(abs(prop(\"마감 남은 일\"))))))"
